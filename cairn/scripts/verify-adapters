#!/usr/bin/env bash
# Run the live adapter format-drift contract checks.
#
# These run each real worker CLI (claude, codex, opencode, pi) on a trivial
# prompt and assert the adapter's parser still understands the output. They
# need the host CLIs authed and make real, billed calls, so they are NOT in
# the default `pytest` run.
#
# A test FAILS when a CLI runs but its format drifted (update the parser);
# it SKIPS when a CLI is missing or can't reach its provider.
#
# Usage:
#   cairn/scripts/verify-adapters            # all adapters
#   cairn/scripts/verify-adapters -k codex   # one adapter
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run pytest tests_live/ -v "$@"
